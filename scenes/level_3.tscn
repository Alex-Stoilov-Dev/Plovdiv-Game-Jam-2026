[sub_resource type="GDScript" id="GDScript_tft0k"]
script/source = "extends Node2D  # Промени го от CharacterBody2D на Node2D

@onready var character = %AnimatedSprite2D # Използвай уникалното име

func _physics_process(_delta: float) -> void:
	if character: # ТАЗИ ПРОВЕРКА СПИРА КРАША
		character.flip_h = true
		character.play(\"idel\") 
		character.z_index = 10 
		character.position = Vector2(1485, 505)
	
	# Излизане от играта с ESC
	if Input.is_action_just_pressed(\"ui_cancel\"):
		get_tree().quit()
"

